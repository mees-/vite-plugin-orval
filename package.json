{
  "name": "vite-plugin-orval",
  "version": "0.1.0",
  "description": "Run orval during vite dev and build, and regenerate your API client whenever the OpenAPI spec changes.",
  "keywords": [
    "codegen",
    "openapi",
    "orval",
    "swagger",
    "typescript",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://github.com/mees-/vite-plugin-orval#readme",
  "bugs": "https://github.com/mees-/vite-plugin-orval/issues",
  "license": "MIT",
  "author": "Mees van Dijk <mees@mees.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mees-/vite-plugin-orval.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepublishOnly": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/picomatch": "^4.0.3",
    "orval": "^8.31.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "orval": "^8.0.0",
    "vite": "^5.1.0 || ^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
